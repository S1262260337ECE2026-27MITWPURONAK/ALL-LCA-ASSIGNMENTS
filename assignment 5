#include <stdio.h>
#include <string.h>

int main() {
    int choice;
    char a[100], b[100], ch;

    while (1) {
        printf("\n1.Length  2.Compare  3.Exit\nChoice: ");
        if (scanf("%d", &choice) != 1) {
            printf("Error: Number only.\n");
            while ((ch = getchar()) != '\n' && ch != EOF);
            continue;
        }
        while ((ch = getchar()) != '\n' && ch != EOF);

        if (choice == 3) break;
        if (choice < 1 || choice > 3) {
            printf("Error: Pick 1 to 3.\n");
            continue;
        }

        printf("Enter string 1: ");
        fgets(a, sizeof(a), stdin);
        a[strcspn(a, "\n")] = '\0';

        if (strlen(a) == 0) {
            printf("Error: Empty string.\n");
            continue;
        }

        if (choice == 1) {
            printf("Length = %zu\n", strlen(a));
        } else {
            printf("Enter string 2: ");
            fgets(b, sizeof(b), stdin);
            b[strcspn(b, "\n")] = '\0';

            if (strlen(b) == 0) {
                printf("Error: Second string is empty.\n");
            } else if (strcmp(a, b) == 0) {
                printf("Equal\n");
            } else {
                printf("Not equal\n");
            }
        }
    }
    return 0;
}
