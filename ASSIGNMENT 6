#include <stdio.h>
long long factorial(int n) {
    if (n <= 1) return 1;
    return n * factorial(n - 1);
}
int main() {
    int n;
    while (1)
     {
        printf("Enter a non-negative integer (0-20): ");
        if (scanf("%d", &n) != 1) {
            printf("Error: Invalid input! Please enter a valid integer.\n\n");
            while (getchar() != '\n');
            continue; 
        }
        if (n < 0) {
            printf("Error: Negative numbers are not allowed!\n\n");
            continue; 
        }
       
        printf("Factorial of %d = %lld\n", n, factorial(n));
        break; 
    }

    return 0;
}
